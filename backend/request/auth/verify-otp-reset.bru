meta {
  name: Verify OTP (reset)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "purpose": "reset",
    "email": "{{email}}",
    "code": "123456"
  }
}

script:post-response {
  if (res.body.resetToken) bru.setVar("resetToken", res.body.resetToken);
}

docs {
  see verify-otp-reset.md
}
